rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 유저 데이터: 본인만 읽고 쓰기 가능
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    
    // 검사 문항 데이터: 읽기 전용 (어드민 SDK는 이를 무시하고 쓸 수 있음)
    match /questions/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    
    // 시나리오 데이터: 읽기 전용 (어드민 SDK는 이를 무시하고 쓸 수 있음)
    match /scenarios/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // 약관·운영 정보·공지 배너: 읽기 전용 (어드민 SDK는 이를 무시하고 쓸 수 있음)
    //
    // 인증을 걸지 않는 이유는 **로그인 전에도 보여야 하는 값**이기 때문이다.
    // 약관 전문은 동의 게이트와 가입 화면에서 읽고(동의 전이므로 계정이 아직
    // 없다), 공지 배너는 랜딩부터 뜬다. 담기는 내용도 이미 공개된 게시물이라
    // 열어 두는 데 위험이 없다 — 개인정보는 users 컬렉션에만 있다.
    match /settings/{document=**} {
      allow read: if true;
      allow write: if false;
    }

  }
}