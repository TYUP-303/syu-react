# Firebase 환경 변수 설정 템플릿 (Vite 전용)
# 이 파일을 복사하여 .env.local을 생성한 후 실제 Firebase 정보를 입력하세요.
# ⚠️ .env.local 파일은 절대 Git 리포지토리에 커밋하지 마세요.

# Firebase Web SDK Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id_here

# 개발 및 디버그용 이메일 바이패스 계정 설정
# (미설정 상태로 앱을 구동할 경우 아래의 기본값으로 자동 대입됩니다)
VITE_DEV_LOGIN_EMAIL=dev@example.com
VITE_DEV_LOGIN_PASSWORD=change_me

# 테스트/로컬 전용: true면 Firebase 에뮬레이터(auth 9099, firestore 8080)로 연결
VITE_USE_EMULATOR=false